# Palindrome check in FLANG

word := "madam";
reversed_word := reverse(word);

print(f"Original: {word}");
print(f"Reversed: {reversed_word}");

if word == reversed_word {
    print(f"{word} is a palindrome");
} else {
    print(f"{word} is NOT a palindrome");
}

# try a second word to show the non-palindrome case
word2 := "forensic";
reversed_word2 := reverse(word2);

if word2 == reversed_word2 {
    print(f"{word2} is a palindrome");
} else {
    print(f"{word2} is NOT a palindrome");
}
